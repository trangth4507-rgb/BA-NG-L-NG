rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cho phép đọc và ghi dữ liệu kỳ lương (khi có đăng nhập hoặc lưu trữ an toàn)
    match /payroll_periods/{periodId} {
      allow read, write: if true;
    }
    match /settings/{docId} {
      allow read, write: if true;
    }
    match /employees_master/{employeeId} {
      allow read, write: if true;
    }
    match /products_master/{productId} {
      allow read, write: if true;
    }
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
